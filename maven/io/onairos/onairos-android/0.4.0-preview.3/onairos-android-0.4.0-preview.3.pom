    </license>
  </licenses>
  <developers>
    <developer>
      <id>onairos</id>
      <name>Onairos</name>
      <email>developer@onairos.io</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/onairos-dev/onairos-android-kotlin-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/onairos-dev/onairos-android-kotlin-sdk.git</developerConnection>
    <url>https://github.com/onairos-dev/onairos-android-kotlin-sdk</url>
  </scm>
  <dependencies>
    <dependency>
