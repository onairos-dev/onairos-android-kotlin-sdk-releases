  <groupId>io.onairos</groupId>
  <artifactId>onairos-android</artifactId>
  <version>0.4.0-preview.3</version>
  <packaging>aar</packaging>
  <name>Onairos Android SDK</name>
  <description>Onairos account authorization, connectors and training for native Android applications</description>
